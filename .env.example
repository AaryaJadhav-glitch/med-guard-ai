# ==============================================================================
# Med-Guard AI - Environment Configuration Example
# Copy this file to .env (or server/.env and client/.env)
# ==============================================================================

# Backend Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Supabase Credentials (Required for both Server and Client)
# Find these in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://wvqqlgyowcaphywvzgof.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
# The Service Role Key is strictly server-side only for admin operations & migrations!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...
# Direct DB Connection string for migration runner (optional alternative to Service Role HTTP/pg)
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-region.pooler.supabase.com:6543/postgres

# Google Gemini API Key (Strictly Server-Side Only)
# Get from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=AIzaSy...

# Frontend Configuration (Vite environment variables must start with VITE_)
VITE_API_URL=http://localhost:5000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

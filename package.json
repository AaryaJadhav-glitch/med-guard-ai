{
  "name": "med-guard-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Med-Guard AI - Clinical Medication Safety & Drug-Interaction Prevention Platform",
  "type": "module",
  "scripts": {
    "start": "npm --prefix server start",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client run dev\"",
    "postinstall": "npm --prefix client install",
    "build": "npm --prefix client run build",
    "test": "npm --prefix server test",
    "migrate": "node supabase/scripts/run-migration.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  }
}